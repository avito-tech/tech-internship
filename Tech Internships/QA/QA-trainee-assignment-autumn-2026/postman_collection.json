            "body": {
              "mode": "raw",
              "raw": "{\n  \"sellerID\": {{sellerID}},\n  \"name\": \"{{itemName}}\",\n  \"price\": 9900,\n  \"statistics\": {\n    \"likes\": 21,\n    \"viewCount\": 11,\n    \"contacts\": 43\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/1/item",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "1",
                "item"
              ]
            },
            "description": "Создаёт объявление. sellerID должен совпадать с id пользователя из Bearer-токена. UUID извлекается из строки status и автоматически сохраняется в itemId. Возможные ошибки: 400 и 401."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "packages": {},
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const body = pm.response.json();",
                  "    const match = String(body.status || '').match(/[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}/i);",
                  "    if (match) {",
                  "        pm.collectionVariables.set('itemId', match[0]);",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "response": [
            {
              "name": "Объявление создано",
              "originalRequest": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "Authorization",
                    "value": "Bearer {{accessToken}}"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"sellerID\": {{sellerID}},\n  \"name\": \"{{itemName}}\",\n  \"price\": 9900,\n  \"statistics\": {\n    \"likes\": 21,\n    \"viewCount\": 11,\n    \"contacts\": 43\n  }\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                },
