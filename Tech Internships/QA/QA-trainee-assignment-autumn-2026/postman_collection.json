    {
      "name": "Объявления",
      "description": "Защищённые ручки. Bearer-токен наследуется из настроек коллекции.",
      "item": [
        {
          "name": "Создать объявление",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
