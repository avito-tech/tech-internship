            "description": "Создаёт пользователя. Перед запросом генерируется уникальный username. После успешного ответа id автоматически сохраняется в sellerID. Возможные ошибки: 400 — некорректный логин или пароль, 409 — пользователь уже существует."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "packages": {},
                "exec": [
                  "pm.collectionVariables.set('username', `student_${Date.now()}`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "packages": {},
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const user = pm.response.json();",
                  "    pm.collectionVariables.set('sellerID', String(user.id));",
                  "    pm.collectionVariables.set('username', user.username);",
                  "}"
                ]
              }
            }
          ],
